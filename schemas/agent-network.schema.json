{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heldy.local/design-intelligence/agent-network.schema.json",
  "title": "Design Intelligence Agent Network",
  "type": "object",
  "required": ["updated", "entry_agent", "agents", "routes"],
  "additionalProperties": false,
  "properties": {
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entry_agent": { "type": "string" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file", "type", "writes_code"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "type": { "enum": ["director", "implementer", "reviewer", "curator", "integrator", "verifier"] },
          "writes_code": { "type": "boolean" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "agents"],
        "additionalProperties": false,
        "properties": {
          "when": { "type": "string" },
          "agents": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
