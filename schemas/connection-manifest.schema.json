{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heldy.local/design-intelligence/connection-manifest.schema.json",
  "title": "Design Intelligence Connection Manifest",
  "type": "object",
  "required": ["updated", "project", "connections"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "project": { "type": "string", "minLength": 1 },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "purpose", "approval_required_for", "stores_secrets"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "status": { "enum": ["available", "optional", "required", "unavailable"] },
          "purpose": { "type": "string", "minLength": 8 },
          "approval_required_for": {
            "type": "array",
            "items": { "type": "string" }
          },
          "stores_secrets": { "const": false }
        }
      }
    }
  }
}
